{
  "governanca-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|read_file|view_file|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import('node:fs').then(async({existsSync})=>{const {resolve}=await import('node:path');const {pathToFileURL}=await import('node:url');const p=existsSync('scripts/hook-agente.mjs')?'scripts/hook-agente.mjs':'../scripts/hook-agente.mjs';process.argv=[process.execPath,resolve(p),'pre-tool'];await import(pathToFileURL(resolve(p)).href);})\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node -e \"import('node:fs').then(async({existsSync})=>{const {resolve}=await import('node:path');const {pathToFileURL}=await import('node:url');const p=existsSync('scripts/hook-agente.mjs')?'scripts/hook-agente.mjs':'../scripts/hook-agente.mjs';process.argv=[process.execPath,resolve(p),'session-start'];await import(pathToFileURL(resolve(p)).href);})\"",
        "timeout": 15
      }
    ]
  }
}
