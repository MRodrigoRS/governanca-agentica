schema: spec-driven
githubCopilot:
  cloudAgent: false

# Contexto global do projeto injetado automaticamente nos prompts de planejamento
context: |
  Projeto: {{ nome_do_projeto }}
  Descrição: {{ descricao_do_projeto }}
  Diretrizes Centrais: Obedeça integralmente a constitution.md e AGENTS.md.
  Idioma: Nomes de domínio, contratos, tabelas e mensagens de commit em Português do Brasil (PT-BR). Termos técnicos em Inglês.
  Padrões Obrigatórios:
  - Test-First mandatório (teste falhando no terminal antes do código de produção).
  - Tipagem estrita e validação de schema declarativa na fronteira (Zod / Pydantic / Serde).
  - Interface web responsiva mobile-first (320px+) e portabilidade PWA inata.
  - Reatividade limpa: proibido location.reload() ou recarregamentos forçados de tela.
  - Feedback visual garantido: Toasts reativos para mutações de dados e Modais de confirmação para ações destrutivas.

# Regras determinísticas aplicadas a cada artefato do OpenSpec (D32)
rules:
  proposal:
    - "O porquê da mudança deve estar claro e justificado sob cabeçalho '## Por que' ou '## Why'"
    - "O escopo deve ser fechado especificando '## O que muda' ou '## What Changes'"
    - "Deve conter menção explícita a '## Fica de Fora' ou '## Out of Scope'"
    - "Mínimo de 10 linhas úteis de detalhamento"
  specs:
    - "Estruturar em deltas usando cabeçalhos oficiais (## ADDED Requirements, ## MODIFIED Requirements, etc.)"
    - "Cada requisito deve conter '### Requirement:' e ao menos um cenário '#### Scenario:' com WHEN e THEN (GIVEN recomendado)"
    - "Especificar contratos de dados e tabelas com nomes em Português do Brasil"
  design:
    - "Conter cabeçalho '## Contratos, Dados e Schemas' com schemas declarativos e tipos"
    {% if 'web-ui' in perfis_projeto or 'desktop' in perfis_projeto or 'mobile' in perfis_projeto %}
    - "Conter cabeçalho '## Interface e Estados Assíncronos' (ou 'Não se aplica: <motivo>') detalhando loading, empty, error, success, Toasts e Modais"
    {% else %}
    - "Conter cabeçalho '## Interface e Estados Assíncronos' indicando 'Não se aplica: projeto sem interface gráfica de usuário'"
    {% endif %}
    - "Conter cabeçalho '## Regras de Negócio e Segurança' com regras ACID, validação e autorização"
    - "Mínimo de 18 linhas úteis de detalhamento"
  tasks:
    - "Checklist com tarefas atômicas '- [ ]' ou '- [x]'"
    - "Marcação obrigatória de ciclo Test-First com 'Vermelho' / 'Red' / 'teste falhando'"
    - "Conter seção obrigatória '## Roteiro de Validação Prática' com passo a passo e dados prontos"
    - "Conter seção obrigatória '## Notas de Sessão' para handoff determinístico com decisões fora do plano, bloqueios e próximo passo"
    - "Mínimo de 12 linhas úteis de detalhamento"
