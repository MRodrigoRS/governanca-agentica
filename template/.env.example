# ==============================================================================
# Variáveis de Ambiente do Projeto — .env.example
# ==============================================================================
# IMPORTANTE:
# 1. NUNCA comite credenciais, segredos de produção ou chaves privadas reais aqui.
# 2. Toda variável utilizada no código de produção DEVE ser declarada neste arquivo.
# 3. O script 'verificar-governanca.mjs' audita a paridade de variáveis de ambiente.
# ==============================================================================

# Porta do Servidor / Aplicação
PORT=3000

# URL de Conexão com o Banco de Dados (Exemplo)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/meubanco"

# Chave Secreta de Sessão / JWT (Placeholder)
AUTH_SECRET="sua-chave-secreta-de-sessao-aqui"

# Integrações Externas (Placeholders)
# GATEWAY_API_KEY=""
# SERVICO_EMAIL_TOKEN=""
