{
  "governanca-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|read_file|view_file|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node ../template/scripts/hook-agente.mjs pre-tool",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node ../template/scripts/hook-agente.mjs session-start",
        "timeout": 15
      }
    ]
  }
}
